&НаКлиенте
Процедура ПослеПомещенияФайлаИмпорта(Результат, АдресФайла, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

    Если Не Результат Тогда
        Возврат;
    КонецЕсли;

    Попытка

        КоличествоСтрок = ИмпортироватьФайлПродажНаСервере(
            АдресФайла,
            ВыбранноеИмяФайла
        );

        Сообщить("Импорт завершен. Загружено строк: " + Строка(КоличествоСтрок));

    Исключение

        Сообщить("Ошибка импорта: " + ОписаниеОшибки());

    КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ИмпортироватьФайлПродажНаСервере(АдресФайла, ИмяФайла)

    Если Не ЗначениеЗаполнено(Объект.Маркетплейс) Тогда
        ВызватьИсключение "Перед загрузкой файла выберите маркетплейс.";
    КонецЕсли;

    ФайлИмпорта = Новый Файл(ИмяФайла);
    Расширение = НРег(ФайлИмпорта.Расширение);

    Если Лев(Расширение, 1) = "." Тогда
        Расширение = Сред(Расширение, 2);
    КонецЕсли;

    Если Расширение <> "csv" И Расширение <> "xml" Тогда
        ВызватьИсключение "Поддерживаются только файлы CSV и XML.";
    КонецЕсли;

    ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);

    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("." + Расширение);
    ДвоичныеДанные.Записать(ИмяВременногоФайла);

    Попытка

        Если Расширение = "csv" Тогда
            ДанныеИмпорта = ПрочитатьCSVПродаж(ИмяВременногоФайла);
        Иначе
            ДанныеИмпорта = ПрочитатьXMLПродаж(ИмяВременногоФайла);
        КонецЕсли;

    Исключение

        Попытка
            УдалитьФайлы(ИмяВременногоФайла);
        Исключение
        КонецПопытки;

        ВызватьИсключение ОписаниеОшибки();

    КонецПопытки;

    Попытка
        УдалитьФайлы(ИмяВременногоФайла);
    Исключение
    КонецПопытки;

    Если ДанныеИмпорта.Количество() = 0 Тогда
        ВызватьИсключение "Файл не содержит строк продаж.";
    КонецЕсли;

    Ошибки = Новый Массив;

    ПодготовленныеСтроки = Новый ТаблицаЗначений;
    ПодготовленныеСтроки.Колонки.Добавить("Товар");
    ПодготовленныеСтроки.Колонки.Добавить("Количество");
    ПодготовленныеСтроки.Колонки.Добавить("ЦенаПродажи");

    Для Каждого СтрокаИмпорта Из ДанныеИмпорта Цикл

        ИдентификаторТовара = СокрЛП(Строка(СтрокаИмпорта.ИдентификаторТовара));

        Если ПустаяСтрока(ИдентификаторТовара) Тогда
            Ошибки.Добавить(
                "Строка " + Строка(СтрокаИмпорта.НомерСтрокиФайла)
                + ": не заполнен идентификатор товара."
            );
            Продолжить;
        КонецЕсли;

        Товар = НайтиТоварПоИдентификатору(ИдентификаторТовара);

        Если Не ЗначениеЗаполнено(Товар) Тогда
            Ошибки.Добавить(
                "Строка " + Строка(СтрокаИмпорта.НомерСтрокиФайла)
                + ": товар с идентификатором """ + ИдентификаторТовара + """ не найден."
            );
            Продолжить;
        КонецЕсли;

        Попытка
            Количество = СтрокуВЧисло(СтрокаИмпорта.КоличествоТекст);
        Исключение
            Ошибки.Добавить(
                "Строка " + Строка(СтрокаИмпорта.НомерСтрокиФайла)
                + ": количество должно быть числом."
            );
            Продолжить;
        КонецПопытки;

        Если Количество <= 0 Тогда
            Ошибки.Добавить(
                "Строка " + Строка(СтрокаИмпорта.НомерСтрокиФайла)
                + ": количество должно быть больше нуля."
            );
            Продолжить;
        КонецЕсли;

        Попытка
            ЦенаПродажи = СтрокуВЧисло(СтрокаИмпорта.ЦенаПродажиТекст);
        Исключение
            Ошибки.Добавить(
                "Строка " + Строка(СтрокаИмпорта.НомерСтрокиФайла)
                + ": цена продажи должна быть числом."
            );
            Продолжить;
        КонецПопытки;

        Если ЦенаПродажи < 0 Тогда
            Ошибки.Добавить(
                "Строка " + Строка(СтрокаИмпорта.НомерСтрокиФайла)
                + ": цена продажи не может быть отрицательной."
            );
            Продолжить;
        КонецЕсли;

        НоваяСтрока = ПодготовленныеСтроки.Добавить();
        НоваяСтрока.Товар = Товар;
        НоваяСтрока.Количество = Количество;
        НоваяСтрока.ЦенаПродажи = ЦенаПродажи;

    КонецЦикла;

    Если Ошибки.Количество() > 0 Тогда
        ВызватьИсключение "Ошибки импорта:" + Символы.ПС + ТекстОшибокИмпорта(Ошибки);
    КонецЕсли;

    Объект.Товары.Очистить();

    Для Каждого СтрокаИмпорта Из ПодготовленныеСтроки Цикл

        НоваяСтрока = Объект.Товары.Добавить();

        НоваяСтрока.Товар = СтрокаИмпорта.Товар;
        НоваяСтрока.Количество = СтрокаИмпорта.Количество;
        НоваяСтрока.ЦенаПродажи = СтрокаИмпорта.ЦенаПродажи;

        РассчитатьСтрокуТоваровНаСервере(НоваяСтрока);

    КонецЦикла;

    Возврат ПодготовленныеСтроки.Количество();

КонецФункции

&НаСервере
&НаСервере
Функция ПрочитатьCSVПродаж(ИмяВременногоФайла)

    ОшибкаUTF8 = "";

    Попытка
        Возврат ПрочитатьCSVПродажСКодировкой(ИмяВременногоФайла, КодировкаТекста.UTF8);
    Исключение
        ОшибкаUTF8 = ОписаниеОшибки();
    КонецПопытки;

    Попытка
        Возврат ПрочитатьCSVПродажСКодировкой(ИмяВременногоФайла, КодировкаТекста.ANSI);
    Исключение
        ВызватьИсключение
            "Не удалось прочитать CSV-файл." + Символы.ПС
            + "Ошибка UTF-8: " + ОшибкаUTF8 + Символы.ПС
            + "Ошибка ANSI: " + ОписаниеОшибки();
    КонецПопытки;

КонецФункции


&НаСервере
Функция ПрочитатьCSVПродажСКодировкой(ИмяВременногоФайла, Кодировка)

    ТекстовыйДокумент = Новый ТекстовыйДокумент;
    ТекстовыйДокумент.Прочитать(ИмяВременногоФайла, Кодировка);

    Если ТекстовыйДокумент.КоличествоСтрок() < 2 Тогда
        ВызватьИсключение "CSV-файл не содержит строк продаж.";
    КонецЕсли;

    Заголовок = ТекстовыйДокумент.ПолучитьСтроку(1);
    Разделитель = ОпределитьРазделительCSV(Заголовок);

    Заголовки = СтрРазделить(Заголовок, Разделитель);

    ИндексИдентификатор = ИндексКолонкиCSV(
        Заголовки,
        "ИдентификаторТовара,Идентификатор товара,Артикул,Код,Товар"
    );

    ИндексКоличество = ИндексКолонкиCSV(
        Заголовки,
        "Количество,Кол-во,Колво"
    );

    ИндексЦенаПродажи = ИндексКолонкиCSV(
        Заголовки,
        "ЦенаПродажи,Цена продажи,Цена"
    );

    Если ИндексИдентификатор < 0 Тогда
        ВызватьИсключение
            "В CSV-файле отсутствует колонка ИдентификаторТовара. "
            + "Первая строка файла: " + Заголовок;
    КонецЕсли;

    Если ИндексКоличество < 0 Тогда
        ВызватьИсключение
            "В CSV-файле отсутствует колонка Количество. "
            + "Первая строка файла: " + Заголовок;
    КонецЕсли;

    Если ИндексЦенаПродажи < 0 Тогда
        ВызватьИсключение
            "В CSV-файле отсутствует колонка ЦенаПродажи. "
            + "Первая строка файла: " + Заголовок;
    КонецЕсли;

    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("НомерСтрокиФайла");
    Результат.Колонки.Добавить("ИдентификаторТовара");
    Результат.Колонки.Добавить("КоличествоТекст");
    Результат.Колонки.Добавить("ЦенаПродажиТекст");

    Для НомерСтроки = 2 По ТекстовыйДокумент.КоличествоСтрок() Цикл

        СтрокаФайла = СокрЛП(ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки));

        Если ПустаяСтрока(СтрокаФайла) Тогда
            Продолжить;
        КонецЕсли;

        Поля = СтрРазделить(СтрокаФайла, Разделитель);

        НоваяСтрока = Результат.Добавить();
        НоваяСтрока.НомерСтрокиФайла = НомерСтроки;
        НоваяСтрока.ИдентификаторТовара = ПолучитьПолеCSV(Поля, ИндексИдентификатор);
        НоваяСтрока.КоличествоТекст = ПолучитьПолеCSV(Поля, ИндексКоличество);
        НоваяСтрока.ЦенаПродажиТекст = ПолучитьПолеCSV(Поля, ИндексЦенаПродажи);

    КонецЦикла;

    Возврат Результат;

КонецФункции


&НаСервере
Функция ОпределитьРазделительCSV(Заголовок)

    Если СтрНайти(Заголовок, ";") > 0 Тогда
        Возврат ";";
    КонецЕсли;

    Если СтрНайти(Заголовок, Символы.Таб) > 0 Тогда
        Возврат Символы.Таб;
    КонецЕсли;

    Если СтрНайти(Заголовок, ",") > 0 Тогда
        Возврат ",";
    КонецЕсли;

    Возврат ";";

КонецФункции


&НаСервере
Функция ИндексКолонкиCSV(Заголовки, ДопустимыеИмена)

    Для Индекс = 0 По Заголовки.Количество() - 1 Цикл

        ТекущееИмя = НормализоватьИмяКолонки(Заголовки[Индекс]);

        Для Каждого ДопустимоеИмя Из СтрРазделить(ДопустимыеИмена, ",") Цикл

            Если ТекущееИмя = НормализоватьИмяКолонки(ДопустимоеИмя) Тогда
                Возврат Индекс;
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    Возврат -1;

КонецФункции


&НаСервере
Функция НормализоватьИмяКолонки(ИмяКолонки)

    Результат = ОчиститьПолеCSV(ИмяКолонки);

    Результат = СтрЗаменить(Результат, Символ(65279), "");
    Результат = СтрЗаменить(Результат, "ï»¿", "");
    Результат = СтрЗаменить(Результат, "п»ї", "");

    Результат = НРег(Результат);

    Результат = СтрЗаменить(Результат, " ", "");
    Результат = СтрЗаменить(Результат, Символ(160), "");
    Результат = СтрЗаменить(Результат, "_", "");
    Результат = СтрЗаменить(Результат, "-", "");
    Результат = СтрЗаменить(Результат, ".", "");

    Возврат Результат;

КонецФункции


&НаСервере
Функция ПолучитьПолеCSV(Поля, Индекс)

    Если Индекс < 0 Или Индекс >= Поля.Количество() Тогда
        Возврат "";
    КонецЕсли;

    Возврат ОчиститьПолеCSV(Поля[Индекс]);

КонецФункции


&НаСервере
Функция ОчиститьПолеCSV(ЗначениеПоля)

    Результат = СокрЛП(Строка(ЗначениеПоля));

    Результат = СтрЗаменить(Результат, Символ(65279), "");
    Результат = СтрЗаменить(Результат, "ï»¿", "");
    Результат = СтрЗаменить(Результат, "п»ї", "");

    Кавычка = Символ(34);

    Если Лев(Результат, 1) = Кавычка
        И Прав(Результат, 1) = Кавычка Тогда

        Результат = Сред(Результат, 2, СтрДлина(Результат) - 2);
        Результат = СтрЗаменить(Результат, Кавычка + Кавычка, Кавычка);

    КонецЕсли;

    Возврат СокрЛП(Результат);

КонецФункции
&НаСервере
Функция ПрочитатьXMLПродаж(ИмяВременногоФайла)

    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("НомерСтрокиФайла");
    Результат.Колонки.Добавить("ИдентификаторТовара");
    Результат.Колонки.Добавить("КоличествоТекст");
    Результат.Колонки.Добавить("ЦенаПродажиТекст");

    ЧтениеXML = Новый ЧтениеXML;
    ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);

    ТекущаяСтрока = Неопределено;
    ТекущийЭлемент = "";
    НомерЗаписи = 1;

    Пока ЧтениеXML.Прочитать() Цикл

        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

            ИмяЭлемента = ЧтениеXML.Имя;

            Если ИмяЭлемента = "Продажа"
                Или ИмяЭлемента = "Строка"
                Или ИмяЭлемента = "Row" Тогда

                ТекущаяСтрока = Результат.Добавить();
                ТекущаяСтрока.НомерСтрокиФайла = НомерЗаписи;
                НомерЗаписи = НомерЗаписи + 1;

            ИначеЕсли ТекущаяСтрока <> Неопределено Тогда

                ТекущийЭлемент = ИмяЭлемента;

            КонецЕсли;

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда

            Если ТекущаяСтрока <> Неопределено Тогда

                ЗначениеЭлемента = СокрЛП(ЧтениеXML.Значение);

                Если ТекущийЭлемент = "ИдентификаторТовара" Тогда
                    ТекущаяСтрока.ИдентификаторТовара = ЗначениеЭлемента;
                ИначеЕсли ТекущийЭлемент = "Количество" Тогда
                    ТекущаяСтрока.КоличествоТекст = ЗначениеЭлемента;
                ИначеЕсли ТекущийЭлемент = "ЦенаПродажи" Тогда
                    ТекущаяСтрока.ЦенаПродажиТекст = ЗначениеЭлемента;
                КонецЕсли;

            КонецЕсли;

        ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

            Если ЧтениеXML.Имя = "Продажа"
                Или ЧтениеXML.Имя = "Строка"
                Или ЧтениеXML.Имя = "Row" Тогда

                ТекущаяСтрока = Неопределено;

            КонецЕсли;

            ТекущийЭлемент = "";

        КонецЕсли;

    КонецЦикла;

    ЧтениеXML.Закрыть();

    Возврат Результат;

КонецФункции

