&НаСервере
Функция НайтиТоварПоИдентификатору(ИдентификаторТовара)

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Товары.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.Товары КАК Товары
    |ГДЕ
    |   НЕ Товары.ПометкаУдаления
    |   И (
    |       Товары.Артикул = &ИдентификаторТовара
    |       ИЛИ Товары.Код = &ИдентификаторТовара
    |   )";

    Запрос.УстановитьПараметр("ИдентификаторТовара", ИдентификаторТовара);

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Справочники.Товары.ПустаяСсылка();

КонецФункции

&НаСервере
Процедура РассчитатьСтрокуТоваровНаСервере(СтрокаТовары)

    СтрокаТовары.СуммаПродажи = СтрокаТовары.Количество * СтрокаТовары.ЦенаПродажи;

    СебестоимостьЕдиницы = 0;

    Если ЗначениеЗаполнено(СтрокаТовары.Товар) Тогда
        СебестоимостьЕдиницы = СтрокаТовары.Товар.Себестоимость;
    КонецЕсли;

    СтрокаТовары.Себестоимость = СтрокаТовары.Количество * СебестоимостьЕдиницы;

    КомиссияПроцент = 0;

    Если ЗначениеЗаполнено(Объект.Маркетплейс) Тогда
        КомиссияПроцент = Объект.Маркетплейс.КомиссияПроцент;
    КонецЕсли;

    СтрокаТовары.Комиссия = Окр(
        СтрокаТовары.СуммаПродажи * КомиссияПроцент / 100,
        2
    );

    СтрокаТовары.ЧистаяПрибыль =
        СтрокаТовары.СуммаПродажи
        - СтрокаТовары.Комиссия
        - СтрокаТовары.Себестоимость;

КонецПроцедуры

&НаСервере
Функция СтрокуВЧисло(Значение)

    Текст = СокрЛП(Строка(Значение));

    Текст = СтрЗаменить(Текст, " ", "");
    Текст = СтрЗаменить(Текст, Символ(160), "");

    Если ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "Пустое числовое значение.";
    КонецЕсли;

    Попытка
        Возврат Число(Текст);
    Исключение
    КонецПопытки;

    Попытка
        Возврат Число(СтрЗаменить(Текст, ".", ","));
    Исключение
    КонецПопытки;

    Возврат Число(СтрЗаменить(Текст, ",", "."));

КонецФункции


&НаСервере
Функция ТекстОшибокИмпорта(Ошибки)

    Результат = "";

    Для Каждого Ошибка Из Ошибки Цикл

        Если Результат <> "" Тогда
            Результат = Результат + Символы.ПС;
        КонецЕсли;

        Результат = Результат + Ошибка;

    КонецЦикла;

    Возврат Результат;

КонецФункции